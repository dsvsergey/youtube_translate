{
  "manifest_version": 3,
  "name": "YouTube Live Translate",
  "version": "1.0.0",
  "description": "Перекладає субтитри YouTube у реальному часі та озвучує переклад.",
  "permissions": ["storage"],
  "host_permissions": ["https://clients5.google.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Live Translate"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/lib.js", "src/stt.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
